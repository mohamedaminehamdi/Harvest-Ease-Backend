# MongoDB connection string (required)
DB_URI=mongodb://127.0.0.1:27017/harvestEase

# Secret used to sign login tokens (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Port the API listens on (the frontend expects 5000)
PORT=5000

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Google Gemini API key for the chatbot
GOOGLE_GEN_AI_KEY=

# Clerk sign-in (POST /auth/sync-user). Both come from the Clerk dashboard:
# the JWT public key (PEM, "\n" escapes are fine) and a backend secret key.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=

# Gemini model for the chatbot (optional)
GEMINI_MODEL=gemini-2.5-flash

# Max /auth requests per IP per 15 minutes (default 20)
AUTH_RATE_LIMIT=20

# Number of reverse proxies in front of the API (so rate limits see real client IPs)
TRUST_PROXY=
